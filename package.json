    "prepare": "husky",
    "upgrade": "bun run scripts/upgrade.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.1011.0",
    "@aws-sdk/client-s3": "^3.1011.0",
