{
  "name": "cdn-mark-life",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "bunx --bun ultracite fix",
    "check": "bunx --bun ultracite check",
