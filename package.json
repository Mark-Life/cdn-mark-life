    "@types/bun": "^1.3.9",
    "@workspace/typescript-config": "workspace:*",
    "bun-types": "^1.3.9",
    "husky": "^9.1.7",
    "turbo": "^2.8.1",
    "typescript": "5.9.3",
    "ultracite": "7.2.3"
  },
  "packageManager": "bun@1.3.9",
